# Copy to /etc/verifier.env, fill in real values, chmod 600.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'

# Signs session cookies. Rotating it logs every admin out.
FLASK_SECRET=

# Admin panel password. At least 12 characters.
ADMIN_SECRET=

# Where the app keeps its state.
VERIFIER_HOME=/var/www/verifier
DB_PATH=/var/www/verifier/db.sqlite
CA_DIR=/var/www/verifier/ca

# Passphrase encrypting the CA private key at rest.
# Leave empty only if the CA key predates this setting.
CA_PASSPHRASE=

# Device-certificate login: off | proxy | direct
#   off    - endpoint disabled, only TOTP and challenge-response cert login work
#   proxy  - trust mutual-TLS results from a proxy in TRUSTED_PROXIES; requires
#            both ssl_client_certificate and ssl_verify_client optional to be
#            uncommented in deploy/nginx-verifier.conf, or the browser is
#            never asked for a certificate and this stays broken
#   direct - read the peer certificate from our own TLS socket (dev only)
MTLS_MODE=proxy

# TCP peers allowed to assert mTLS headers and X-Real-IP. Behind the unix
# socket there is no peer address; PROXY_SHARED_SECRET is the proof instead.
TRUSTED_PROXIES=127.0.0.1,::1

# Lifetimes
SESSION_TTL_MINUTES=30
DOWNLOAD_TTL_HOURS=24
NONCE_TTL_SECONDS=300
CERT_VALID_DAYS=730
# Admin logins expire server-side after this long.
ADMIN_SESSION_MINUTES=60

# Rate limits (attempts per window)
RL_ADMIN_LOGIN_MAX=5
RL_TOTP_MAX=10
RL_MTLS_MAX=20
# Each open result page polls every 2 s, i.e. 30 per minute per viewer.
RL_STATUS_MAX=300

# Shared secret proving a request traversed our nginx. Required when
# MTLS_MODE=proxy. deploy.sh writes it into the nginx snippet.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_SHARED_SECRET=

# ── Operations (read by deploy/*.sh, not by the application) ──────────
# Host the public certificate is checked for.
PUBLIC_HOST=secure.fin-tech.com

# Encrypts deploy/backup.sh archives. Keep a copy off this machine.
BACKUP_PASSPHRASE=
# Optional: user@host:/path to copy every archive off the host.
BACKUP_REMOTE=
