# Copy to /etc/verifier.env, fill in real values, chmod 600.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'

# Signs session cookies. Rotating it logs every admin out.
FLASK_SECRET=

# Admin panel password. At least 12 characters.
ADMIN_SECRET=

# Where the app keeps its state.
VERIFIER_HOME=/var/www/verifier
DB_PATH=/var/www/verifier/db.sqlite
CA_DIR=/var/www/verifier/ca

# Passphrase encrypting the CA private key at rest.
# Leave empty only if the CA key predates this setting.
CA_PASSPHRASE=

# Device-certificate login: off | proxy | direct
#   off    - endpoint disabled (safe default)
#   proxy  - trust mutual-TLS results from TRUSTED_PROXIES, requires the
#            nginx config in deploy/nginx-verifier.conf
#   direct - read the peer certificate from our own TLS socket
MTLS_MODE=off

# Addresses permitted to assert mTLS headers and X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Lifetimes
SESSION_TTL_MINUTES=30
DOWNLOAD_TTL_HOURS=24
NONCE_TTL_SECONDS=300
CERT_VALID_DAYS=730

# Rate limits (attempts per window)
RL_ADMIN_LOGIN_MAX=5
RL_TOTP_MAX=10
RL_MTLS_MAX=20
RL_STATUS_MAX=300

# Shared secret proving a request traversed our nginx. Required when
# MTLS_MODE=proxy. deploy.sh writes it into the nginx snippet.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_SHARED_SECRET=
